# Auth.js / NextAuth
AUTH_SECRET=replace-with-a-long-random-string
AUTH_URL=http://localhost:3000

# Google OAuth ("Continue with Google"). Required for the Google sign-in
# button to work — leave unset in dev if you don't need it, but the button
# will fail at the Google consent step until both are provided.
# Create credentials at https://console.developers.google.com/apis/credentials
# (OAuth client type "Web application") and set the authorized redirect URI to:
#   http://localhost:3000/api/auth/callback/google   (dev)
#   https://<your-domain>/api/auth/callback/google    (prod)
# Server-side only — never prefix with NEXT_PUBLIC_ or expose the secret to
# the browser.
GOOGLE_CLIENT_ID=replace-with-your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=replace-with-your-google-oauth-client-secret

# Server-side only — never prefix with NEXT_PUBLIC_. The Express API base URL
# this Next.js server proxies auth/verification calls to.
SERVER_URL=http://localhost:4000

# Must match the Express server's INTERNAL_API_SECRET
INTERNAL_API_SECRET=replace-with-a-long-random-string

# Signs the short-lived upload authorizations for verification videos. Must match
# the Worker's UPLOAD_TOKEN_SECRET, be at least 32 characters, and differ from
# INTERNAL_API_SECRET (it is never sent to the browser, only tokens signed with it).
UPLOAD_TOKEN_SECRET=replace-with-a-different-long-random-string

# Public on purpose: Socket.IO requires the browser to open a direct
# connection to the Express server for realtime matchmaking events (a
# websocket can't be proxied through a Next.js Route Handler the way REST
# calls are). The connection is still authenticated via a short-lived,
# server-minted ticket — the browser is never trusted with a raw user id.
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000

# Testing only — leave unset. Forces WebRTC calls to route through the TURN
# relay exclusively (no direct/STUN path), so you can confirm your TURN
# server actually works in isolation. Public on purpose (it's a mode name,
# not a secret) but should never be set to "relay" in normal use.
# NEXT_PUBLIC_ICE_TRANSPORT_POLICY=relay
