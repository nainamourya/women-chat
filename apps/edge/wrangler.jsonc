{
  // Placeholder-only configuration. Nothing here identifies a real Cloudflare
  // account, Hyperdrive config, domain or secret. Nothing is deployed from this
  // branch yet.
  "name": "giigirl-edge",
  // Built by scripts/build.mjs: the Worker entry plus the Express server's
  // routers/services it reuses (with the db/env/socket modules swapped for
  // Worker-safe versions). wrangler then bundles the npm packages.
  "main": "dist/worker.mjs",
  "build": {
    "command": "node scripts/build.mjs",
    "watch_dir": ["src", "../server/src"]
  },
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      // Placeholder id (all zeros). A real Hyperdrive config is created later,
      // outside this stage, and its id is not committed here.
      "id": "00000000000000000000000000000000"
      // The local connection string is deliberately NOT written here. The test
      // harness injects it through the environment, and only after it passes
      // apps/server/src/config/testTargetGuard.ts (see test/localWorker.ts).
    }
  ]
  // Environment variables (NODE_ENV, CORS_ORIGIN, INTERNAL_API_SECRET, the
  // METERED_TURN_* / TURN_* settings) are intentionally not declared here: the
  // secrets must never be committed, and the Worker fails closed (503 on every
  // request) until they are provided. See src/config.ts.
}
