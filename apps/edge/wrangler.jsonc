{
  // Placeholder-only configuration. Nothing here identifies a real Cloudflare
  // account, Hyperdrive config, domain or secret. Nothing is deployed from this
  // branch yet.
  "name": "giigirl-edge",
  // Built by scripts/build.mjs: the Worker entry plus the Express server's
  // routers/services it reuses (with the db/env/socket modules swapped for
  // Worker-safe versions). wrangler then bundles the npm packages.
  "main": "dist/worker.mjs",
  "build": {
    "command": "node scripts/build.mjs",
    "watch_dir": ["src", "../server/src"]
  },
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      // Placeholder id (all zeros). A real Hyperdrive config is created later,
      // outside this stage, and its id is not committed here.
      "id": "00000000000000000000000000000000"
      // The local connection string is deliberately NOT written here. The test
      // harness injects it through the environment, and only after it passes
      // apps/server/src/config/testTargetGuard.ts (see test/localWorker.ts).
    }
  ],
  // Private object storage (Stage E). The bucket name is a placeholder: nothing
  // here points at a real bucket, and nothing in this repo creates or touches
  // one. Local runs use wrangler's simulated R2 bucket.
  "r2_buckets": [{ "binding": "PRIVATE_BUCKET", "bucket_name": "giigirl-private-bucket-placeholder" }],
  // Real-time layer (Stage C), replacing Redis + Socket.IO. See REALTIME.md.
  "durable_objects": {
    "bindings": [
      { "name": "CONN", "class_name": "Conn" },
      { "name": "USER_HUB", "class_name": "UserHub" },
      { "name": "TICKETS", "class_name": "TicketStore" },
      { "name": "LIMITER", "class_name": "Limiter" },
      { "name": "MATCHMAKER", "class_name": "Matchmaker" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Conn", "UserHub", "TicketStore", "Limiter"] },
    { "tag": "v2", "new_sqlite_classes": ["Matchmaker"] }
  ],
  // Staging (Stage F). Bindings are not inherited by a wrangler environment, so
  // everything is repeated. Every id/name below is a PLACEHOLDER: replace them
  // locally (or in CI) when the staging resources exist. Staging deliberately has
  // its own Worker name, Hyperdrive config, bucket and Durable Object namespaces
  // (Durable Object classes are namespaced per Worker name), so it cannot touch
  // production data. No routes or custom domains: it is served from workers.dev
  // only, and nothing here is deployed. See STAGING.md.
  "env": {
    "staging": {
      "name": "giigirl-edge-staging",
      "workers_dev": true,
      "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "3a428d565fce4a59b3f30cee9ff17faa" }],
      "r2_buckets": [{ "binding": "PRIVATE_BUCKET", "bucket_name": "giigirl-private-staging" }],
      "durable_objects": {
        "bindings": [
          { "name": "CONN", "class_name": "Conn" },
          { "name": "USER_HUB", "class_name": "UserHub" },
          { "name": "TICKETS", "class_name": "TicketStore" },
          { "name": "LIMITER", "class_name": "Limiter" },
          { "name": "MATCHMAKER", "class_name": "Matchmaker" }
        ]
      },
      "migrations": [
        { "tag": "v1", "new_sqlite_classes": ["Conn", "UserHub", "TicketStore", "Limiter"] },
        { "tag": "v2", "new_sqlite_classes": ["Matchmaker"] }
      ]
    },
    // Production. Its own Worker name (so its own Durable Object namespaces), the
    // production Hyperdrive config and the existing production bucket (same object
    // keys as the Express server, so existing files stay readable). workers.dev
    // only: no routes or custom domains. Deploy only with --env production.
    "production": {
      "name": "giigirl-edge-production",
      "workers_dev": true,
      // giigirl-production-db → Neon branch "production" (ep-noisy-feather…), the
      // same database Render uses. NOT apps/server/.env, which is the Neon
      // "development" branch (ep-falling-unit…); 99951ea7… points there and
      // must never be used for production.
      "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "4682ff8c403c46c087e4dbe86fbf3207" }],
      "r2_buckets": [{ "binding": "PRIVATE_BUCKET", "bucket_name": "giigril-verification-videos" }],
      "durable_objects": {
        "bindings": [
          { "name": "CONN", "class_name": "Conn" },
          { "name": "USER_HUB", "class_name": "UserHub" },
          { "name": "TICKETS", "class_name": "TicketStore" },
          { "name": "LIMITER", "class_name": "Limiter" },
          { "name": "MATCHMAKER", "class_name": "Matchmaker" }
        ]
      },
      "migrations": [
        { "tag": "v1", "new_sqlite_classes": ["Conn", "UserHub", "TicketStore", "Limiter"] },
        { "tag": "v2", "new_sqlite_classes": ["Matchmaker"] }
      ]
    }
  },
  // Environment variables (NODE_ENV, CORS_ORIGIN, INTERNAL_API_SECRET, the
  // METERED_TURN_* / TURN_* settings) are intentionally not declared here: the
  // secrets must never be committed, and the Worker fails closed (503 on every
  // request) until they are provided. See src/config.ts.
}
