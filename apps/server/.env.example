NODE_ENV=development
PORT=4000

# Local docker-compose Postgres (see root docker-compose.yml)
DATABASE_URL=postgresql://womenchat:womenchat@localhost:5432/womenchat

# Local docker-compose Redis
REDIS_URL=redis://localhost:6379

# Must match the web app's NEXT_PUBLIC_APP_ORIGIN in dev
CORS_ORIGIN=http://localhost:3000

# Shared secret between the Next.js server and this API. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_API_SECRET=replace-with-a-long-random-string

# PROTOTYPE ONLY: local-disk directory for uploaded report evidence images.
# Not served publicly. Replace with object storage (e.g. S3) + signed URLs
# and a retention/auto-deletion job for production — see evidenceStorage.ts.
REPORT_EVIDENCE_DIR=./uploads/reports
