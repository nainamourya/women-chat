# REQUIRED and has no default — the server refuses to start if this is missing
# or invalid, so a misconfigured deployment can never silently behave like a
# development one (development-only routes such as the verification
# simulation stay disabled everywhere except "development").
#   local development : development   (read from this file; a local .env is
#                                       only ever loaded for development)
#   deployed (Render) : production     (set in the host's dashboard, never in a file)
#   automated tests   : test           (set by the test runner — see .env.test.example)
# On Render the server also refuses to start unless this is "production".
NODE_ENV=development
PORT=4000

# Local docker-compose Postgres (see root docker-compose.yml)
DATABASE_URL=postgresql://womenchat:womenchat@localhost:5432/womenchat

# Local docker-compose Redis
REDIS_URL=redis://localhost:6379

# Must match the web app's NEXT_PUBLIC_APP_ORIGIN in dev. Comma-separated
# if the web app is served from more than one domain in production, e.g.
# CORS_ORIGIN=https://women-chat.vercel.app,https://www.giigirl.com
CORS_ORIGIN=http://localhost:3000

# Shared secret between the Next.js server and this API. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Local development accepts 16+ characters. In production it must be at
# least 32 characters, random (not repetitive) and not a placeholder, and
# must be identical to INTERNAL_API_SECRET on the Next.js (Vercel) side.
INTERNAL_API_SECRET=replace-with-a-long-random-string

# PROTOTYPE ONLY: local-disk directory for uploaded report evidence images.
# Not served publicly. Replace with object storage (e.g. S3) + signed URLs
# and a retention/auto-deletion job for production — see evidenceStorage.ts.
REPORT_EVIDENCE_DIR=./uploads/reports

# Introduction-verification videos, pending manual admin review. Deleted
# immediately after a decision is recorded — see videoStorage.ts.
VERIFICATION_VIDEO_MAX_BYTES=26214400
VERIFICATION_VIDEO_MAX_DURATION_SECONDS=15

# Cloudflare R2 (S3-compatible) — the private bucket backing verification
# video storage. Never commit real values. Endpoint is the account-specific
# R2 S3 API URL, e.g. https://<account_id>.r2.cloudflarestorage.com
R2_ENDPOINT=https://replace-with-your-account-id.r2.cloudflarestorage.com
R2_BUCKET_NAME=giigril-verification-videos
R2_ACCESS_KEY_ID=replace-with-your-r2-access-key-id
R2_SECRET_ACCESS_KEY=replace-with-your-r2-secret-access-key

# --- WebRTC TURN relay (all optional) ---
# Without these, calls use STUN only and can fail across strict NATs/
# firewalls (this is what causes "Call connection failed..." on some
# networks/devices). Get a TURN URL + credentials from a managed provider —
# e.g. Metered.ca (metered.ca/tools/openrelay, has a free tier) or Xirsys
# (xirsys.com) both work; comma-separate multiple URLs.
# TURN_URLS=turn:relay.example.com:80,turns:relay.example.com:443

# Preferred, if your provider gives you a "shared secret" / "static auth
# secret" (coturn-style) rather than a fixed username+password — this lets
# the server mint a fresh, short-lived credential per call instead of
# shipping one permanent password. Metered and Xirsys both support this.
# TURN_STATIC_AUTH_SECRET=replace-with-your-provider's-shared-secret

# Fallback only, if your provider instead gives you a single fixed
# username/password pair (no shared-secret option) — less secure since it
# doesn't expire on its own; rotate it periodically in the provider's
# dashboard. Use this OR TURN_STATIC_AUTH_SECRET above, not both.
# TURN_STATIC_USERNAME=replace-with-provider-username
# TURN_STATIC_CREDENTIAL=replace-with-provider-credential

# How long a minted short-lived TURN credential stays valid for (seconds).
TURN_CREDENTIAL_TTL_SECONDS=3600

# Alternative to TURN_URLS/TURN_STATIC_* above: metered.ca mints short-lived
# TURN credentials via its own REST API (checked first; falls back to
# TURN_URLS, then STUN-only, if unset or if the API call fails).
# Get <appname> and the API key from your metered.ca dashboard.
# METERED_TURN_APP_NAME=replace-with-your-metered-app-name
# METERED_TURN_API_KEY=replace-with-your-metered-api-key
# METERED_TURN_REGION=india
